# PostgreSQL used by Prisma when the domain model is added.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lowpos"

# At least 32 random characters in production.
AUTH_SECRET="replace-with-a-long-random-production-secret"

# Cloudinary: keep these values on the server. Never prefix them with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
